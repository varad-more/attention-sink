# Attention Sink - local configuration template.
#
# Copy to .env and adjust. NEVER put credentials in this file or in .env.
# AWS access uses the default credential chain (SSO, instance role, or profile);
# there is no access-key variable here by design.

# ---------------------------------------------------------------------------
# Runtime mode
#
# local      - deterministic fixture responses, no AWS account needed. All output
#              is labelled as simulated and can never be canonical.
# production - real Bedrock calls. Fails closed if anything below is unset.
# ---------------------------------------------------------------------------
AS_RUNTIME_MODE=local

# ---------------------------------------------------------------------------
# Experiment identity. Stamped onto every event, manifest, and API response.
# AS_GIT_COMMIT is normally injected by CI rather than set by hand.
# ---------------------------------------------------------------------------
AS_PROTOCOL_VERSION=2026.08-draft
AS_GIT_COMMIT=

# ---------------------------------------------------------------------------
# AWS. Required in production mode only. No default Region is compiled in.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Model gateway.
#
# fixture - deterministic local responses, no AWS account needed. All output is
#           marked simulated. Refused when AS_RUNTIME_MODE=production.
# bedrock - real Bedrock calls. Fails closed without a Region and all five
#           model identifiers below.
#
# This is a separate switch from AS_RUNTIME_MODE on purpose. Calling real
# Bedrock from a local process is legitimate; serving fabricated generations
# from a production one is not.
# ---------------------------------------------------------------------------
MODEL_MODE=fixture

# ---------------------------------------------------------------------------
# Bedrock model identifiers, one per role. Required in bedrock mode only.
# Recorded verbatim in every run manifest: changing one changes the experiment.
# ---------------------------------------------------------------------------
WRITER_MODEL_ID=amazon.nova-2-lite-v1:0
AUDITOR_MODEL_ID=amazon.nova-2-lite-v1:0
JUDGE_MODEL_ID=amazon.nova-2-lite-v1:0
SUMMARY_MODEL_ID=amazon.nova-2-lite-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ---------------------------------------------------------------------------
# Inference and transport. Applied identically to every arm and recorded on
# every call. Unlike a model identifier these have defaults, because a number
# this repository chooses cannot change underneath a run.
# ---------------------------------------------------------------------------
WRITER_TEMPERATURE=0.7
WRITER_TOP_P=0.9
WRITER_MAX_TOKENS=1024
SUMMARY_MAX_TOKENS=256
REQUEST_TIMEOUT_SECONDS=60
MAX_MODEL_RETRIES=3

# ---------------------------------------------------------------------------
# Opt-in contract tests against real Bedrock. They cost money and are skipped
# unless this is exactly "1". See `make test-contract`.
# ---------------------------------------------------------------------------
AS_BEDROCK_CONTRACT_TESTS=

# ---------------------------------------------------------------------------
# Deployment. Everything here defaults to "do nothing": a stack that is deployed
# but not armed is a state, not an accident.
#
# local      - a laptop or a test. Never touches a deployed table.
# staging    - real AWS, real models, non-canonical output. What Phase 7 deploys.
# production - real AWS, and the only environment a canonical run may exist in.
# ---------------------------------------------------------------------------
AS_DEPLOYMENT_ENVIRONMENT=local

# The DynamoDB table and the run this process serves. Both come from the stack
# outputs after a deploy; there is no default for either.
AS_TABLE_NAME=
AS_PILOT_RUN_ID=run_aws_staging

# The private export bucket and the bus the cycle-completed event is published on.
# An empty bus name means the account's default bus.
AS_EXPORT_BUCKET=
AS_EVENT_BUS_NAME=

# The two switches that let a deployment spend anything. Only the exact strings
# "1" and "true" arm either one, so a typo cannot arm a deployment by accident.
#
# AS_EXECUTION_ENABLED  - whether the run-cycle handler may advance a run at all.
# ALLOW_BEDROCK_CALLS   - whether a real provider may be invoked.
#
# They are separate because they fail differently: the first wrong means a run
# advancing that nobody meant to start, the second means money spent.
AS_EXECUTION_ENABLED=false
ALLOW_BEDROCK_CALLS=

# A ceiling below the protocol's own, for an environment that must not run the
# whole experiment. Staging sets it short so that arming the scheduler by mistake
# costs a handful of cycles rather than a whole experiment's worth of generations.
AS_MAX_CYCLES=

# Browser origins the deployed read API answers. Comma separated, never a
# wildcard. Set to the CloudFront domain after the first deploy.
AS_ALLOWED_ORIGINS=

# Whether this deployment may create a canonical run. Refused outside production,
# and never set by Phase 7.
AS_CANONICAL=

# Where the protocol files are inside the deployment package. Set by the stack;
# a laptop uses the repository-relative default.
AS_PROTOCOL_ROOT=

# The deployed run-cycle function, for `make aws-invoke-once`. From the
# RunCycleFunctionName stack output.
AS_RUN_CYCLE_FUNCTION=

# ---------------------------------------------------------------------------
# Web client. Vite only exposes variables prefixed VITE_ to browser code.
# ---------------------------------------------------------------------------
VITE_RUNTIME_MODE=local
VITE_API_BASE_URL=http://localhost:5173/api
