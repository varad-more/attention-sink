# Attention Sink - local configuration template.
#
# Copy to .env and adjust. NEVER put credentials in this file or in .env.
# AWS access uses the default credential chain (SSO, instance role, or profile);
# there is no access-key variable here by design.

# ---------------------------------------------------------------------------
# Runtime mode
#
# local      - deterministic fixture responses, no AWS account needed. All output
#              is labelled as simulated and can never be canonical.
# production - real Bedrock calls. Fails closed if anything below is unset.
# ---------------------------------------------------------------------------
AS_RUNTIME_MODE=local

# ---------------------------------------------------------------------------
# Experiment identity. Stamped onto every event, manifest, and API response.
# AS_GIT_COMMIT is normally injected by CI rather than set by hand.
# ---------------------------------------------------------------------------
AS_PROTOCOL_VERSION=2026.08-draft
AS_GIT_COMMIT=

# ---------------------------------------------------------------------------
# AWS. Required in production mode only. No default Region is compiled in.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Bedrock model identifiers, one per role. Required in production mode only.
# Recorded verbatim in every run manifest: changing one changes the experiment.
# ---------------------------------------------------------------------------
WRITER_MODEL_ID=amazon.nova-2-lite-v1:0
AUDITOR_MODEL_ID=amazon.nova-2-lite-v1:0
JUDGE_MODEL_ID=amazon.nova-2-lite-v1:0
SUMMARY_MODEL_ID=amazon.nova-2-lite-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ---------------------------------------------------------------------------
# Web client. Vite only exposes variables prefixed VITE_ to browser code.
# ---------------------------------------------------------------------------
VITE_RUNTIME_MODE=local
VITE_API_BASE_URL=http://localhost:5173/api
