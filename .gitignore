# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
dist/
*.egg-info/

# Node
node_modules/
apps/web/dist/
*.tsbuildinfo

# CDK
infrastructure/cdk/cdk.out/
infrastructure/cdk/.cdk.staging/

# Local configuration and secrets. .env.example is committed; .env never is.
.env
.env.*
!.env.example

# Editors and OS
.DS_Store
.idea/
.vscode/

# Local pilot run exports. Regenerated by `make pilot-local-run`; each carries its
# own checksum manifest, so a committed copy would go stale silently.
.pilot-runs/

# Generated knowledge-graph artifacts. Rebuilt by `/graphify`; the cache is large
# and machine-specific, so a committed copy would go stale silently.
graphify-out/

# The local SQLite database and its write-ahead log. Regenerated by
# `make local-db-migrate`; a committed copy would be one machine's run history.
.pilot-local/

# Playwright output. Regenerated by `make pilot-local-e2e`.
apps/web/test-results/
apps/web/playwright-report/
apps/web/e2e-results.json
apps/web/dist/
